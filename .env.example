# ═══════════════════════════════════════════════════════════
# نمونه فایل تنظیمات ربات زرکوین
# ═══════════════════════════════════════════════════════════
# این فایل را به .env کپی کنید و مقادیر را پر کنید:
#   cp .env.example .env
#
# روی VPS: این فایل به‌صورت خودکار توسط install.sh ساخته می‌شود
# روی Railway: متغیرها را در پنل Railway تنظیم کنید (این فایل لازم نیست)
# ═══════════════════════════════════════════════════════════

# ─── تنظیمات ربات ───
# توکن ربات را از @BotFather بگیرید
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# آیدی عددی ادمین (از @userinfobot بگیرید)
OWNER_ID=123456789

# موجودی شروع کاربران جدید (پیش‌فرض: 0)
START_BALANCE=0

# ─── تنظیمات دیتابیس MySQL ───
# روی VPS با install.sh: به‌صورت خودکار پر می‌شود
# روی Railway: این متغیرها را استفاده کنید:
#   MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE

DB_HOST=localhost
DB_PORT=3306
DB_USER=zarbot
DB_PASSWORD=رمز_قوی_اینجا
DB_NAME=zarbot

# ─── تنظیمات کانال‌ها و گروه (اختیاری) ───
# این‌ها را در فایل config.py ویرایش کنید
# REQUIRED_CHANNELS — لیست کانال‌های جوین اجباری
# REQUIRED_GROUP — گروه جوین اجباری

# ─── مینی‌اپ قمارخانه (Telegram WebApp) ───
# پورت سرور وب (پیش‌فرض: 8080)
WEBAPP_PORT=8080
# URL عمومی سرور مینی‌اپ — روی Railway، از متغیر RAILWAY_PUBLIC_DOMAIN استفاده کنید
# مثال: https://your-app.up.railway.app
WEBAPP_PUBLIC_URL=

# ─── Redis (برای مچ‌میکینگ پایدار مینی‌اپ) ───
# روی Railway: متغیر REDIS_URL به‌صورت خودکار از Redis plugin تزریق می‌شود
# مثال: redis://default:password@railway-redis.railway.internal:6379
# روی VPS: اگر REDIS_URL خالی باشد، از جزئیات جداگانه زیر استفاده می‌شود
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# اگر REDIS_URL خالی باشد، مینی‌اپ در حالت fallback (درون‌حافظه‌ای) اجرا می‌شود
# — صف مچ‌میکینگ از ری‌استارت جان نمی‌برد ولی ربات کار می‌کند
