# ═══════════════════════════════════════════════════════════
# نمونه فایل تنظیمات ربات زرکوین
# ═══════════════════════════════════════════════════════════
# این فایل را به .env کپی کنید و مقادیر را پر کنید:
#   cp .env.example .env
#
# روی VPS: این فایل به‌صورت خودکار توسط install.sh ساخته می‌شود
# روی Railway: متغیرها را در پنل Railway تنظیم کنید (این فایل لازم نیست)
# ═══════════════════════════════════════════════════════════

# ─── تنظیمات ربات ───
# توکن ربات را از @BotFather بگیرید
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# آیدی عددی ادمین (از @userinfobot بگیرید)
OWNER_ID=123456789

# موجودی شروع کاربران جدید (پیش‌فرض: 0)
START_BALANCE=0

# ─── تنظیمات دیتابیس MySQL ───
# روی VPS با install.sh: به‌صورت خودکار پر می‌شود
# روی Railway: این متغیرها را استفاده کنید:
#   MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE

DB_HOST=localhost
DB_PORT=3306
DB_USER=zarbot
DB_PASSWORD=رمز_قوی_اینجا
DB_NAME=zarbot

# ─── تنظیمات کانال‌ها و گروه (اختیاری) ───
# این‌ها را در فایل config.py ویرایش کنید
# REQUIRED_CHANNELS — لیست کانال‌های جوین اجباری
# REQUIRED_GROUP — گروه جوین اجباری
